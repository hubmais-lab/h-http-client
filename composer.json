{
    "name": "hubmais/h-http-client",
    "description": "Http Client to access Api HUBMAIS",
    "type": "library",
    "require": {
        "php": "^7.2 || ^8.0",
        "guzzlehttp/guzzle": "^7.2"
    },
    "require-dev": {
        "pestphp/pest": "^2.36"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hubmais\\HClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hubmais\\HClient\\Providers\\HClientServiceProvider"
            ],
            "aliases": {
                "HClient": "Hubmais\\HClient\\Facades\\HClient"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
